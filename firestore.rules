rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // The caller's own profile document.
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Another user's profile document.
    function userAt(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // A task document, for rules on its subcollections.
    function taskAt(taskId) {
      return get(/databases/$(database)/documents/tasks/$(taskId)).data;
    }

    function isAdmin() {
      return isAuth() && me().role == 'admin';
    }

    function isLead() {
      return isAuth() && me().role == 'lead';
    }

    // The caller's team, or null when they have none.
    function myTeam() {
      return me().get('team', null);
    }

    // Is `uid` on the caller's team?  A lead with no team matches nobody.
    function isMyTeammate(uid) {
      return myTeam() != null && userAt(uid).get('team', null) == myTeam();
    }

    // Can the caller score `uid`'s work?  Nobody reviews themselves — a lead's
    // own tasks have to be signed off by an admin.
    function canReview(uid) {
      return uid != request.auth.uid && (isAdmin() || (isLead() && isMyTeammate(uid)));
    }

    // Team tokens for every team except the caller's own.
    function foreignTeamTokens() {
      return ['team:dev', 'team:ops', 'team:design', 'team:social']
        .removeAll(['team:' + myTeam()]);
    }

    // Is the caller an assignee of this task?  A task can target a member three
    // ways: by uid, by the literal 'all', or by 'team:<team>'.
    function isAssignee(task) {
      return isAuth()
        && (request.auth.uid in task.assignedTo
            || 'all' in task.assignedTo
            || (myTeam() != null && ('team:' + myTeam()) in task.assignedTo));
    }

    // The keys the caller changed inside a map field.  Reading through
    // get(field, {}) keeps this working when the field does not exist yet.
    function mapDiffKeys(field) {
      return request.resource.data.get(field, {})
        .diff(resource.data.get(field, {}))
        .affectedKeys();
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── Users ──────────────────────────────────────────────────
    match /users/{uid} {
      // Anyone authenticated can read any profile (leaderboard, admin views,
      // and resolving 'all' / 'team:<team>' assignments to real people).
      allow read: if isAuth();

      // Sign-up creates the caller's own profile, and the self-heal in
      // AuthContext re-creates it if it ever went missing.  A new account can
      // only ever be its own owner, its own verified email address, a member,
      // and worth zero points — role escalation and pre-loaded points are both
      // blocked here.  The key allowlist keeps anything unexpected out of the
      // document; every field in it is optional, so omitting `team` is fine.
      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'member'
        && request.resource.data.totalPoints == 0
        && request.resource.data.keys().hasOnly(
             ['uid', 'name', 'email', 'role', 'course', 'major', 'team', 'totalPoints',
              'createdAt']);

      // A member edits their own profile only.  totalPoints and role are NOT in
      // this list: points are now awarded exclusively through a review, so the
      // client no longer needs to write them and the old self-award hole is shut.
      allow update: if isOwner(uid)
        && changedKeys().hasOnly(['name', 'major', 'course', 'team']);

      // A lead credits points to their own team-mates, and to nobody else —
      // this is the users half of the review transaction.
      allow update: if isLead()
        && uid != request.auth.uid
        && isMyTeammate(uid)
        && changedKeys().hasOnly(['totalPoints']);

      // Admins can update any user doc (role assignment, point corrections,
      // attendance credit).
      allow update: if isAdmin();

      allow delete: if false;
    }

    // ── Tasks ──────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read: if isAuth();

      // KNOWN LIMITATION: rules have no loops, so we cannot verify that every
      // uid inside a lead's `assignedTo` really belongs to that lead's team.
      // What is enforced here is the shape: no 'all' token and no other team's
      // 'team:<team>' token.  Per-uid membership is checked client-side in
      // src/components/task-workspace.tsx.  The same trade-off is documented
      // for pointsHistory below.
      allow create: if isAdmin()
        || (isLead()
            && myTeam() != null
            && request.resource.data.get('team', null) == myTeam()
            && request.resource.data.createdBy == request.auth.uid
            && !('all' in request.resource.data.assignedTo)
            && !request.resource.data.assignedTo.hasAny(foreignTeamTokens()));

      allow delete: if isAdmin()
        || (isLead() && resource.data.createdBy == request.auth.uid);

      // Admins edit any task; a lead edits only the ones they created.
      allow update: if isAdmin()
        || (isLead()
            && resource.data.createdBy == request.auth.uid
            && changedKeys().hasOnly(['title', 'description', 'points', 'dueDate', 'assignedTo']));

      // An assignee sets their OWN status, and only until it has been reviewed.
      // Comparing the map diff (rather than the whole map) keeps this working on
      // tasks with several assignees — their keys are present but untouched.
      allow update: if isAssignee(resource.data)
        && changedKeys().hasOnly(['assigneeStatus'])
        && mapDiffKeys('assigneeStatus').hasOnly([request.auth.uid])
        && request.resource.data.assigneeStatus[request.auth.uid]
             in ['pending', 'in_progress', 'done']
        && !(request.auth.uid in resource.data.get('assigneeReview', {}));

      // A reviewer scores one assignee.  Rules cannot read a key out of a map
      // diff, so the writer declares the target in `lastReviewedUid` and we
      // verify it is exactly the key that changed — a lie fails that check.
      allow update: if isAuth()
        && changedKeys().hasOnly(['assigneeReview', 'lastReviewedUid'])
        && mapDiffKeys('assigneeReview').hasOnly([request.resource.data.lastReviewedUid])
        && !(request.resource.data.lastReviewedUid in resource.data.get('assigneeReview', {}))
        && resource.data.get('assigneeStatus', {})
             .get(request.resource.data.lastReviewedUid, 'pending') == 'done'
        && request.resource.data
             .assigneeReview[request.resource.data.lastReviewedUid].score is int
        && request.resource.data
             .assigneeReview[request.resource.data.lastReviewedUid].score >= 0
        && request.resource.data
             .assigneeReview[request.resource.data.lastReviewedUid].score <= resource.data.points
        && request.resource.data
             .assigneeReview[request.resource.data.lastReviewedUid].reviewedBy == request.auth.uid
        && canReview(request.resource.data.lastReviewedUid);

      // ── Activity (append-only status/review log) ─────────────
      // Written inside the same transaction as the change it records, so the
      // log cannot drift from the task. `at == request.time` pins it to the
      // server clock: a client cannot backdate or postdate an entry.
      match /activity/{activityId} {
        allow read: if isAuth();

        allow create: if isAuth()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.keys().hasAll(['uid', 'actorUid', 'type', 'at'])
          && request.resource.data.keys().hasOnly(
               ['uid', 'actorUid', 'type', 'from', 'to', 'score', 'at'])
          && (
            // A member logs their own status change, and only on a task they
            // are actually assigned to.
            (request.resource.data.type == 'status'
              && request.resource.data.uid == request.auth.uid
              && isAssignee(taskAt(taskId))
              && request.resource.data.to in ['pending', 'in_progress', 'done'])
            ||
            // A reviewer logs a score for someone they are allowed to review.
            (request.resource.data.type == 'review'
              && canReview(request.resource.data.uid))
          );

        // Append-only.
        allow update, delete: if false;
      }
    }

    // ── Points History (append-only ledger) ────────────────────
    match /pointsHistory/{entryId} {
      // Members read their own entries; leads read their team's; admins read all.
      allow read: if isAuth()
        && (resource.data.uid == request.auth.uid
            || isAdmin()
            || (isLead() && isMyTeammate(resource.data.uid)));

      // Only a reviewer writes here, as part of the review transaction.  Members
      // can no longer append to their own ledger.
      allow create: if isAuth()
        && request.resource.data.reviewedBy == request.auth.uid
        && canReview(request.resource.data.uid);

      // Immutable ledger.
      allow update, delete: if false;
    }

    // ── Attendance ─────────────────────────────────────────────
    match /attendance/{docId} {
      allow read: if isAuth();

      // Nobody files their own day, whatever their role: a "present" mark is
      // worth points, so the same line that stops anyone reviewing their own
      // work applies here — an admin's own attendance is filed by another
      // admin.  Beyond that, an admin files anyone and a lead files their own
      // team-mates, which now includes the lead and any admin on that team.
      // The status allowlist keeps a made-up value out of the ledger maths.
      allow create, update: if request.resource.data.uid != request.auth.uid
        && (isAdmin() || (isLead() && isMyTeammate(request.resource.data.uid)))
        && request.resource.data.markedBy == request.auth.uid
        && request.resource.data.status in ['present', 'late', 'absent', 'excused'];

      allow delete: if false;
    }
  }
}
